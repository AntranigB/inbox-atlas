# Grok (xAI). Chat, STT, realtime voice.
XAI_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning

# Gmail over IMAP. Create an App Password at myaccount.google.com/apppasswords (needs 2FA).
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_MAX_MESSAGES=5000

# Google Calendar secret iCal URL (Calendar settings, "Secret address in iCal format").
GCAL_ICS_URL=

# Encoder: hash | base | path to models/atlas-embed
ATLAS_ENCODER=base
ATLAS_DIM=

# Photon / Spectrum (iMessage). Promo code HACKWITHPHOTON.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
OWNER_PHONE=
# Comma list: imessage, whatsapp, telegram, slack. Extra platforms need their own keys:
SPECTRUM_PROVIDERS=imessage
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=

# Local backend (uv run atlas up). See docs/PHONE.md.
PORT=8765
SIDECAR_PORT=8766
# Shared token for phone access by IP. When set the API listens on all interfaces and asks for it.
ATLAS_TOKEN=
# mock = run the iMessage sidecar in mock mode without Photon credentials, off = never start it
ATLAS_SIDECAR=
# pg = start Postgres with docker compose and keep chat history there
ATLAS_DB=

TIMEZONE=America/New_York
OWNER_HANDLES=
ALLOW_ANY=0
BRIEF_TIME=08:00
QUIET_HOURS=22-7
NOTIFY=1
